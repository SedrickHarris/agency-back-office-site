# Production site URL, no trailing slash. Used by lib/site.ts for metadataBase,
# canonicals, sitemap, and robots. Set ONLY for production builds. When unset
# (local and preview builds), robots.txt disallows all crawling.
# The production domain is not decided yet, so no value is provided here.
NEXT_PUBLIC_SITE_URL=

# Public Cloudflare Turnstile site key for the Contact form (not a secret).
# Create the widget in the Cloudflare dashboard. Inlined at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
